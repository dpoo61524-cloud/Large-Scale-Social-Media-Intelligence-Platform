# ==============================================================================
# Environment Configuration Template (.env.example)
#
# IMPORTANT:
# - Copy this file to '.env' before running the application:
#     cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# - Replace placeholder values with your real credentials.
# - NEVER commit the actual '.env' file to version control.
# ==============================================================================

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 1. Social Media Data Collection APIs (Reddit & YouTube)
# Ref: Step 1 - Collect data with Reddit and YouTube APIs
#
# NOTICE: External live Reddit API access requires approved developer status
# under Reddit's Data API Developer Terms (https://www.reddit.com/dev/api).
# For offline development and testing, mock ingestion is available without keys.
# ------------------------------------------------------------------------------
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=social-media-intelligence:v1.0 (by /u/your_username)
REDDIT_TARGET_SUBREDDITS=datascience,technology,MachineLearning

# YouTube Data API v3 (Google Cloud Console with YouTube Data API v3 enabled)
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_SEARCH_QUERY=social media intelligence machine learning

# ------------------------------------------------------------------------------
# 2. Graph Database (Neo4j)
# Ref: Step 5 - User-interaction graph and influencer ranking
# ------------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ------------------------------------------------------------------------------
# 3. Search & Analytics Engine (Elasticsearch & Kibana)
# Ref: Step 7 - Indexing, search, trends, alerts and Kibana dashboards
# ------------------------------------------------------------------------------
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_elastic_password_here

KIBANA_HOST=http://localhost:5601

# ------------------------------------------------------------------------------
# 4. Storage Directories
# ------------------------------------------------------------------------------
RAW_DATA_PATH=data/raw
PROCESSED_DATA_PATH=data/processed
MODELS_PATH=models

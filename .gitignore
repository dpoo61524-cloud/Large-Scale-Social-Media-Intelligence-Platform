# ==========================================
# Python Virtual Environments
# ==========================================
venv/
.venv/
venv-spark/
hadoop/
env/
ENV/
env.bak/
venv.bak/

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.local
.env.*.local
*.env
!.env.example

# ==========================================
# Python Bytecode & Cache Files
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# ==========================================
# Local Datasets (Data Directories)
# Preserve directory structure but ignore files
# ==========================================
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.csv
*.json
!data/sample_reddit_posts.json
!data/sample_reddit_interactions.json
*.parquet
*.tsv
*.zip
*.tar.gz

# ==========================================
# Runtime Orchestration Artifacts
# ==========================================
data/runs/
data/.orchestration.lock
*.lock

# ==========================================
# Model Artifacts
# Preserve directory structure but ignore binaries
# ==========================================
models/*
!models/.gitkeep
*.pkl
*.joblib
*.pt
*.bin
*.onnx
*.h5

# ==========================================
# IDE & Editor Specific Files
# ==========================================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ==========================================
# Logs & Build Output
# ==========================================
*.log
build/
dist/
*.egg-info/
# ==========================================
# Presentations & Documentation Binaries
# ==========================================
*.pptx
*.ppt
*.docx
*.doc
docs/
scratch/
verification_screenshots_largescale/

